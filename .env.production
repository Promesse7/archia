# ARCHIA Production Environment Configuration

# Production
NODE_ENV=production
VITE_APP_TITLE=ARCHIA
VITE_APP_DESCRIPTION=Archaeological Pottery Reconstruction AI
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=true
VITE_SENTRY_DSN=https://your-sentry-dsn
VITE_API_BASE_URL=https://api.archia.ai
VITE_CDN_URL=https://cdn.archia.ai

# Feature Flags
VITE_ENABLE_3D_VIEWER=true
VITE_ENABLE_CAMERA=true
VITE_ENABLE_PUZZLE=true
VITE_ENABLE_GALLERY=true

# Performance Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_BUNDLE_ANALYZER=false

# Debug Settings
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error

# Security Settings
VITE_ENABLE_CSP=true
VITE_ENABLE_HSTS=true
